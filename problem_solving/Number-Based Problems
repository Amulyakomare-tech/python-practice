"""
NUMBER-BASED PROBLEMS
"""

# -----------------------------------
# 1️⃣ Armstrong Number
# -----------------------------------

number = int(input("Enter a number: "))

original_number = number
sum_of_digits = 0

while number > 0:
    digit = number % 10
    sum_of_digits += digit ** 3
    number //= 10

if original_number == sum_of_digits:
    print("Armstrong Number")
else:
    print("Not an Armstrong Number")


# -----------------------------------
# 2️⃣ Palindrome Number
# -----------------------------------

number = int(input("\nEnter another number: "))

original = number
reverse = 0

while number > 0:
    digit = number % 10
    reverse = reverse * 10 + digit
    number //= 10

if original == reverse:
    print("Palindrome Number")
else:
    print("Not a Palindrome Number")


# -----------------------------------
# 3️⃣ Factorial
# -----------------------------------

number = int(input("\nEnter number for factorial: "))

factorial = 1

for i in range(1, number + 1):
    factorial *= i

print("Factorial:", factorial)